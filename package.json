{
  "name": "@local/permanent-session-delete",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Permanently deletes a conversation from the sidebar Session menu.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuanYuan-JC/permanent-session-delete.git"
  },
  "homepage": "https://github.com/YuanYuan-JC/permanent-session-delete#readme",
  "bugs": {
    "url": "https://github.com/YuanYuan-JC/permanent-session-delete/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
